    {
      "id": "3a000001-0000-4000-8000-000000000001",
      "title": "Life of one TODO item",
      "elements": [
        {
          "id": "9e5c3142-6f70-4c8d-9ea3-40216c9d5f33",
          "title": "1. The TODO list starts empty - no confirmation is outstanding",
          "tags": [],
          "index": 0,
          "specRow": 0,
          "type": "READMODEL",
          "fields": [],
          "expectEmptyList": true
        },
        {
          "id": "7c3a1f20-4d5e-4a6b-9c81-2e0f5a7b3d11",
          "title": "2. A guest books a table",
          "tags": [],
          "index": 0,
          "specRow": 0,
          "type": "COMMAND",
          "fields": [],
          "expectEmptyList": false
        },
        {
          "id": "8d4b2031-5e6f-4b7c-8d92-3f105b8c4e22",
          "title": "3. ReservationPlaced - this OPENS the TODO item",
          "tags": [],
          "index": 0,
          "specRow": 0,
          "type": "EVENT",
          "fields": [],
          "expectEmptyList": false
        },
        {
          "id": "9e5c3142-6f70-4c8d-9ea3-40216c9d5f33",
          "title": "4. The task is now on the list - one row, one confirmation owed",
          "tags": [],
          "index": 0,
          "specRow": 0,
          "type": "READMODEL",
          "fields": [],
          "expectEmptyList": false
        },
        {
          "id": "a06d4253-7081-4d9e-8fb4-51327dae6044",
          "title": "5. The background process reads the list and picks the row up",
          "tags": [],
          "index": 0,
          "specRow": 0,
          "type": "AUTOMATION",
          "fields": [],
          "expectEmptyList": false
        },
        {
          "id": "b17e5364-8192-4eaf-9ac5-62438ebf7155",
          "title": "6. It issues SendReservationConfirmation for that row",
          "tags": [],
          "index": 0,
          "specRow": 0,
          "type": "COMMAND",
          "fields": [],
          "expectEmptyList": false
        },
        {
          "id": "c28f6475-92a3-4fb0-8bd6-73549fc08266",
          "title": "7. ReservationConfirmationSent - this CLOSES the TODO item",
          "tags": [],
          "index": 0,
          "specRow": 0,
          "type": "EVENT",
          "fields": [],
          "expectEmptyList": false
        },
        {
          "id": "9e5c3142-6f70-4c8d-9ea3-40216c9d5f33",
          "title": "8. The row is gone. The list is empty again - so the process has nothing left to act on and the confirmation cannot be sent a second time",
          "tags": [],
          "index": 0,
          "specRow": 0,
          "type": "READMODEL",
          "fields": [],
          "expectEmptyList": true
        }
